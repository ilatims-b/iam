# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Virtual env
.venv/

# macOS
.DS_Store

# Data: the trajectory record is third-party data shared for this project and
# is not redistributed; synthetic.csv is regenerated by make_synthetic.py
*.csv

# Calibration outputs: only the small files needed to rebuild the report's
# figures and tables are kept (the three compared runs and the sensitivity
# profiles of the free fit). Every other run is in the further-experiments
# archive linked from the README.
results/*
!results/idm_duggal_by_class.json
!results/idm_duggal_by_class_annotated.json
!results/j12_dims/
!results/j13_duggal_idm/
!results/j14_chandra_dims/
results/j1[234]_*/*
!results/j1[234]_*/class_params.json
!results/j1[234]_*/run_config.json
!results/j1[234]_*/split.json
!results/j1[234]_*/convergence.csv
!results/j12_dims/oat_profiles.csv

# Report: sources and figures are kept, build outputs are not
paper_joint/*
!paper_joint/calib_report/
paper_joint/calib_report/*.pdf
paper_joint/calib_report/*.aux
paper_joint/calib_report/*.log
paper_joint/calib_report/*.out
paper_joint/calib_report/*.toc
paper_joint/calib_report/*.fls
paper_joint/calib_report/*.fdb_latexmk
paper_joint/calib_report/figs/scores_*.json
paper_joint/calib_report/figs/numbers.json
